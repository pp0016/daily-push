59a8\"\n\n# The specific string to use as the cut-off point (from the screenshot)\nexclude_marker = \"Whatever you can do, do it right now. Don't stop.\"\n\ndef generate_export():\n    history = []\n    \n    if not os.path.exists(transcript_path):\n        print(f\"Transcript not found at {transcript_path}\")\n        return\n        \n    with open(transcript_path, 'r', encoding='utf-8') as f:\n        for line in f:\n            if not line.strip():\n                continue\n            try:\n                entry = json.loads(line)\n                step_type = entry.get('type')\n                \n                # Extract text content\n                content = entry.get('content', '')\n                if not content and 'tool_calls' in entry:\n                    content = \"\\n\".join([f\"*[Executed tool: {tc.get('name', 'unknown')}]*\" for tc in entry['tool_calls']])\n                    \n                if step_type == 'USER_INPUT':\n                    # Check if this is the excluded prompt\n                    if exclude_marker in content:\n                        print(\"Found exclusion marker. Stopping parsing.\")\n                        break # Stop parsing entirely, excluding this and everything after\n                        \n                    # Remove <CONTEXT_SUMMARY> blocks from user input if present to keep it clean\n                    content = re.sub(r'<CONTEXT_SUMMARY>.*?</CONTEXT_SUMMARY>', '[Context Summary Omitted for Readability]', content, flags=re.DOTALL)\n                    content = re.sub(r'<SYSTEM_MESSAGE>.*?</SYSTEM_MESSAGE>', '', content, flags=re.DOTALL)\n                    content = re.sub(r'<ADDITIONAL_METADATA>.*?</ADDITIONAL_METADATA>', '', content, flags=re.DOTALL)\n                    \n                    history.append({'role': 'User', 'content': content.strip()})\n                    \n                elif step_type == 'PLANNER_RESPONSE':\n                    if content:\n                        history.append({'role': 'Agent', 'content': content.strip()})\n                        \n            except Exception as e:\n                print(f\"Error parsing line: {e}\")\n                \n    # Build the markdown content\n    md_content = \"# Conversation Export\\n\\n\"\n    \n    # 1. Artifacts Paths\n    md_content += \"## Generated Artifacts Paths\\n\"\n    # List actual .md files in the artifacts dir (excluding this export)\n    for file in os.listdir(artifacts_dir):\n        if file.endswith('.md') and file != 'conversation_export.md' and file != 'task.md' and file != 'implementation_plan.md' and file != 'walkthrough.md':\n            md_content += f\"- `file:///{artifacts_dir.replace(chr(92), '/')}/{file}`\\n\"\n            \n    md_content += \"\\n## Conversation History\\n\\n\"\n    \n    # 2. Conversation History\n    for msg in history:\n        if not msg['content']:\n            continue\n        role_header = \"### ðŸ‘¤ User\" if msg['role'] == 'User' else \"### ðŸ¤– Agent\"\n        md_content += f\"{role_header}\\n\\n{msg['content']}\\n\\n---\\n\\n\"\n        \n    with open(output_path, 'w', encoding='utf-8') as out:\n        out.write(md_content)\n        \n    print(f\"Export generated successfully at {output_path}\")\n\nif __name__ == '__main__':\n    generate_export()\n","Description":"Python script to parse the conversation transcript, filter the excluded text, and generate the export markdown file.","Overwrite":true,"TargetFile":"C:\\Users\\renu5\\.gemini\\antigravity\\scratch\\export_transcript.py","toolAction":"Writing export script","toolSummary":"Write export script"}}]}
